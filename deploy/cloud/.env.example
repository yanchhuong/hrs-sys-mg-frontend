# HRMS — cloud deployment
# Copy to .env and fill in real values. Never commit .env.

# --- Public ------------------------------------------------------------------
# DNS name that points at this server. Caddy will fetch a TLS cert for it.
PUBLIC_HOST=hrms.example.com
# Matching https:// origin used for CORS.
PUBLIC_ORIGIN=https://hrms.example.com
# Email for Let's Encrypt account + expiry warnings.
ACME_EMAIL=admin@example.com

# --- Database ----------------------------------------------------------------
POSTGRES_USER=hrms
POSTGRES_PASSWORD=CHANGE_ME_long_random_password
POSTGRES_DB=hrms

# --- Secrets -----------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_jwt_secret_at_least_32_chars

# --- Telegram AI-Agent -------------------------------------------------------
# Connection to the HRMS AI-Agent that fans out Telegram messages
# (Invoice notifications, Announcement push, payment receipts). The
# agent runs in its own docker-compose project on the SAME droplet
# (see AI-Agent/docker-compose.yml) — bring it up first.
#
# host.docker.internal:5174 works because the backend compose adds
# `extra_hosts: host.docker.internal:host-gateway` so Linux droplets
# resolve the hostname to the host's bridge IP, and the agent
# publishes :5174 on the host. Override if the agent runs on a
# different machine.
#
# Leave BOTH empty to disable Telegram delivery — the BE skips the
# fan-out and the dialog shows "Telegram delivery is not configured
# on this server."
TELEGRAM_AGENT_BASE_URL=http://host.docker.internal:5174
# Must be IDENTICAL to TELEGRAM_AGENT_SECRET in AI-Agent/.env or the
# agent rejects with 403 "bad agent secret". Generate with
# `openssl rand -hex 32`.
TELEGRAM_AGENT_SECRET=CHANGE_ME_must_match_agent_env

# --- PayWay (ABA) ------------------------------------------------------------
# Symmetric key used to encrypt PayWay API keys at rest. Once set,
# DO NOT change it — credentials encrypted with the old key become
# unreadable on rotation. Generate with `openssl rand -hex 32`.
PAYWAY_ENCRYPTION_KEY=CHANGE_ME_payway_encryption_key
# Public-facing URL the PayWay push webhook is reachable at — used
# by the settings dialog to compose the per-tenant push URL the
# operator pastes into the PayWay dashboard.
APP_PUBLIC_BASE_URL=https://hrms.example.com
