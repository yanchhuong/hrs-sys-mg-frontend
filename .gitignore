# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/

# Vite cache
.vite/
.turbo/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment
.env
.env.*
!.env.example
# Cloud-mode build config (VITE_API_BASE pointing at the docker-hosted
# API). Loaded by `vite build --mode cloud`, ignored by `vite` dev.
# The value is public — Vite bakes it into the JS bundle anyway.
!.env.cloud
# Desktop-mode build config for the Tauri Windows shell. Same public
# URL story as .env.cloud — Vite bakes VITE_API_BASE into the shipped
# exe, so committing it just makes reproducible builds possible.
!.env.desktop

# Editor
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# OS
.DS_Store
Thumbs.db

# Misc
coverage/
*.local

# Claude Code
.claude/

# Docker / deploy
deploy/*/.env
!deploy/*/.env.example
deploy/*/backups/
