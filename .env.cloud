# Cloud-mode build (vite build --mode cloud) — used by Vercel and any other
# remote deploy that runs `npm run build`. Local `npm run dev` does NOT load
# this file, so local development keeps falling through to the
# http://localhost:4000 default in src/app/api/client.ts.
#
# Points at the docker-hosted API behind the /api-02 nginx prefix. The
# smart-join in client.ts strips the call-site `/api/` when the base ends
# in `/api-XX`, so full URLs come out as `…/api-02/v1/...` (not
# `…/api-02/api/v1/...`), matching the upstream's nginx location block.
VITE_API_BASE=http://165.232.164.4:8081/api-02
