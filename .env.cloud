# Cloud-mode build (vite build --mode cloud) — used by Vercel and any other
# remote deploy that runs `npm run build`. Local `npm run dev` does NOT load
# this file, so local development keeps falling through to the
# http://localhost:4000 default in src/app/api/client.ts.
#
# Points at the docker-hosted API used for the cloud-side testing setup.
VITE_API_BASE=http://165.232.164.4:8081
