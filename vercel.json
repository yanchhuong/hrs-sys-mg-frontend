{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api-02/:path*", "destination": "https://hr-share.com/api-02/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
